# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-your-key-here

# Where ChromaDB will save its data locally
CHROMA_PERSIST_DIR=./chroma_db

# Collection name inside ChromaDB
CHROMA_COLLECTION_NAME=rag_docs

# Similarity score threshold for filter node (lower = stricter for cosine distance)
SCORE_THRESHOLD=0.35

# Chunk size for splitting PDF text
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
